{
  "version": 2,
  "buildCommand": "npm run build -w @carswise/api && npm run build -w @carswise/web",
  "outputDirectory": "apps/web/dist",
  "installCommand": "npm install --include=dev",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "apps/api/dist/**"
    }
  },
  "crons": [
    { "path": "/api/cron/kpis", "schedule": "0 4 * * *" },
    { "path": "/api/cron/recordatorios-taller", "schedule": "0 7 * * *" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'; upgrade-insecure-requests" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
